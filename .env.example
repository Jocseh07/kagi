# Build-time client env. Copy to `.env` (gitignored).
#
# Baked into the client bundle by `vite build`, so switching Clerk instances
# needs a rebuild, not just a redeploy. Must name the same instance as
# CLERK_PUBLISHABLE_KEY in your wrangler config.
VITE_CLERK_PUBLISHABLE_KEY=

# Only needed by `pnpm db:generate` (drizzle-kit over the D1 REST API).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
