# The deployment template. Copy to `.env` for `bun run dev`, and to `.env.prod`
# for `bun run deploy`. Both are gitignored; never commit real values.
#
# One file per stage drives both sides: Vite inlines the VITE_ key into the
# client bundle, and Alchemy binds everything else into the Worker. See
# docs/deploy.md.

# Your hostname and its origin. APP_DOMAIN is the custom domain Alchemy binds
# the Worker to; APP_ORIGIN is the same host as a URL, sent as the MangaDex
# User-Agent contact so they can reach whoever runs this deployment. Locally
# APP_ORIGIN is http://localhost:3150 and APP_DOMAIN is your production host,
# which `alchemy dev` never binds.
APP_DOMAIN=kagi.example.com
APP_ORIGIN=https://kagi.example.com

# Sign-in and sync. Every Clerk and Polar value below is optional: without
# them the app is a working offline reader and only sign-in and sync refuse.

# Clerk, from the dashboard. The publishable key is public by design and is
# needed twice — once baked into the client bundle (VITE_), once read by the
# Worker — and both must name the same Clerk instance or tokens fail
# verification. CLERK_JWT_KEY is the PEM public key: with it, token signatures
# are verified locally instead of costing a JWKS round trip per request.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
# Secret.
CLERK_SECRET_KEY=
# Secret.
CLERK_JWT_KEY=
# The exact browser origin(s) allowed to mint tokens, comma-separated. Unset
# means no token is accepted at all. Use http://localhost:3150 locally.
CLERK_AUTHORIZED_PARTIES=

# Polar. Use sandbox.polar.sh while testing and set POLAR_SERVER=sandbox.
# Register <your origin>/api/polar/webhook for `customer.state_changed`.
# Secret.
POLAR_ACCESS_TOKEN=
# Secret.
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_SERVER=production

# Used by `bun run db:generate` only (drizzle-kit over the D1 REST API).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Sentry DSN for this app's project. Empty turns error reporting off.
SENTRY_DSN=

APP_RELEASE_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional local adaptation benchmark connection. Never commit a real API key.
BENCH_ADAPT_ENDPOINT=
BENCH_ADAPT_API_KEY=
