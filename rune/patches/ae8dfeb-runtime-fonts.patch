+/// An owned font collection prepared on a worker and installed atomically by a transaction.
+pub struct FontSet {
+    collection: Collection,
+    sans: String,
+    mono: String,
+    reader: String,
+    font_files: LoadedFiles,
+    symbol_families: Vec<&'static str>,
+    emoji: Option<&'static str>,
+    system_mono: Vec<String>,
+    math: Vec<&'static str>,
+    scripts: u64,
+}
+
+impl FontSet {
+    /// Registers decoded OpenType bytes without retaining static buffers or doing UI-thread IO.
+    pub fn new(fonts: Vec<Arc<[u8]>>, sans: String, mono: String, reader: String) -> Result<Self, String> {
+        let mut collection = Collection::new(CollectionOptions { shared: false, system_fonts: false });
+        let mut registered = Vec::new();
+        for data in DEFAULT_FONTS {
+            registered.extend(collection.register_fonts(Blob::new(Arc::new(data)), None).into_iter().map(|(id, _)| id));
+        }
+        for data in fonts {
+            let added = collection.register_fonts(Blob::new(Arc::new(data)), None);
+            if added.is_empty() { return Err("A font contains no supported OpenType faces".into()); }
+            registered.extend(added.into_iter().map(|(id, _)| id));
+        }
+        for name in [&sans, &mono, &reader] {
+            let first = name.split(',').next().unwrap_or(name).trim().trim_matches(['\'', '"']);
+            if collection.family_id(first).is_none() {
+                return Err(format!("Font family is unavailable: {first}"));
+            }
+        }
+        let mut font_files = LoadedFiles::new();
+        register_cjk_fallbacks(&mut collection, &mut font_files, &registered, (&sans, &mono));
+        let symbol_families = load_families(&mut collection, SYMBOL_FONT_FILES, SYMBOL_FAMILIES);
+        let emoji = symbol_families.iter().copied().find(|family| family.contains("Emoji"));
+        let system_mono = load_system_mono(&mut collection, &mut font_files);
+        let math = load_families(&mut collection, fallback::MATH_FONT_FILES, fallback::MATH_FAMILIES);
+        let mut scripts = 0;
+        for (index, fonts) in fallback::SCRIPT_FONTS.iter().enumerate() {
+            register_script_fallbacks(&mut collection, &mut font_files, fonts);
+            scripts |= 1 << index;
+        }
+        Ok(Self { collection, sans, mono, reader, font_files, symbol_families, emoji, system_mono, math, scripts })
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct FontSetRequest(pub(crate) Arc<std::sync::Mutex<Option<FontSet>>>);
+
+impl std::fmt::Debug for FontSetRequest {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.write_str("FontSetRequest") }
+}
+
+impl TextSystem {
+    pub(crate) fn install_font_set(&mut self, fonts: FontSet) {
+        self.font_cx = FontContext { collection: fonts.collection, source_cache: SourceCache::default() };
+        self.layout_cx = LayoutContext::new();
+        self.scale_cx = ScaleContext::new();
+        self.sans = fonts.sans;
+        self.mono = fonts.mono;
+        self.reader = fonts.reader;
+        self.slot_system_mono = names_system_mono(&self.sans) || names_system_mono(&self.mono);
+        self.font_files = fonts.font_files;
+        self.symbol_families = fonts.symbol_families;
+        self.emoji = fonts.emoji;
+        self.system_mono = Some(fonts.system_mono);
+        self.math = Some(fonts.math);
+        self.scripts = fonts.scripts;
+        self.traks = Traks::new();
+        self.layouts.clear();
+        self.shapes.clear();
+        self.runs.clear();
+        self.primary_traks.clear();
+        self.generation = self.generation.wrapping_add(1);
+    }
+}
