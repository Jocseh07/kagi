{
  "name": "kagi",
  "private": true,
  "portless": {
    "name": "kagi",
    "appPort": 3150,
    "script": "dev:app"
  },
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "portless",
    "dev:app": "alchemy dev --env-file .env",
    "build": "vite build && tsc -b",
    "plan": "alchemy plan --stage prod --env-file .env.prod",
    "deploy": "alchemy deploy --stage prod --env-file .env.prod",
    "lint": "oxlint src",
    "typecheck": "tsc -b --force",
    "db:generate": "drizzle-kit generate && find drizzle -maxdepth 1 -name '*.sql' -exec mv -t migrations {} +",
    "themes:sync": "tsx scripts/fetch-tweakcn-themes.ts",
    "mihon:report": "tsx --tsconfig tsconfig.app.json scripts/mihon-backup-report.ts",
    "mihon:check": "tsx --tsconfig tsconfig.app.json scripts/mihon-import-check.ts",
    "smoke": "tsx scripts/smoke-asura.ts",
    "smoke:mangadot": "tsx scripts/smoke-mangadot.ts",
    "smoke:fenrirealm": "tsx scripts/smoke-fenrirealm.ts",
    "smoke:wuxiaworld": "tsx scripts/smoke-wuxiaworld.ts",
    "stress:generate": "bun scripts/stress-generate.ts",
    "release:prepare": "bun scripts/release.ts prepare",
    "release:publish": "bun scripts/release.ts publish",
    "release": "bun scripts/release.ts release",
    "desktop:dev": "cd desktop && bun run dev",
    "desktop:build": "cd desktop && bun run build",
    "desktop:typecheck": "tsc -p desktop",
    "rune:dev": "bun rune/scripts/dev.ts",
    "rune:check": "bun rune/scripts/check.ts",
    "rune:build": "bun rune/scripts/build.ts",
    "rune:verify": "bun rune/scripts/verify.ts",
    "rune:db:status": "bun rune/scripts/database.ts status",
    "rune:db:init": "bun rune/scripts/database.ts initialize"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@clerk/backend": "^3.16.12",
    "@clerk/react": "^6.14.7",
    "@clerk/ui": "^1.32.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/libre-baskerville": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@polar-sh/sdk": "^0.49.0",
    "@sentry/cloudflare": "^11.0.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-virtual": "^3.14.10",
    "@zip.js/zip.js": "^2.8.55",
    "alchemy": "2.0.0-beta.85",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "effect": "4.1.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@shadcn/lint": "0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
