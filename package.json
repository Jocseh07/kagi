{
  "name": "kagi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3150 --strictPort",
    "build": "vite build && tsc -b",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint src",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply kagi-sync --remote -c $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc)",
    "db:migrate:local": "wrangler d1 migrations apply kagi-sync --local -c $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc)",
    "themes:sync": "tsx scripts/fetch-tweakcn-themes.ts",
    "mihon:report": "tsx --tsconfig tsconfig.app.json scripts/mihon-backup-report.ts",
    "mihon:check": "tsx --tsconfig tsconfig.app.json scripts/mihon-import-check.ts",
    "smoke": "tsx scripts/smoke-asura.ts",
    "smoke:mangadot": "tsx scripts/smoke-mangadot.ts",
    "smoke:fenrirealm": "tsx scripts/smoke-fenrirealm.ts",
    "smoke:wuxiaworld": "tsx scripts/smoke-wuxiaworld.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.12",
    "@clerk/react": "^6.14.7",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/libre-baskerville": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "@polar-sh/sdk": "^0.49.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.32",
