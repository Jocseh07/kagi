# Worker-side secrets for `pnpm dev`. Copy to `.dev.vars` (gitignored).
# In production, set each of these with `wrangler secret put <NAME>`.

# Clerk: from the dashboard. The JWT key is the PEM public key, kept on one
# line with "\n" or quoted across lines.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# The exact browser origin(s) allowed to mint tokens, comma-separated.
CLERK_AUTHORIZED_PARTIES=http://localhost:3150

# Polar: use sandbox.polar.sh while testing.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_SERVER=sandbox

# Your public origin; sent as the MangaDex User-Agent contact.
APP_ORIGIN=http://localhost:3150
